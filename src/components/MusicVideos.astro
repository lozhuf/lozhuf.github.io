---
import { musicVideos as videos, type MusicVideo } from '../lib/music';
import { url } from '../lib/url';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';

interface Props {
  /** A video whose overlay should already be open (for /music/<slug> pages). */
  initial?: MusicVideo;
}

const { initial } = Astro.props;
---

<SiteHeader section="music" />

<main class="music" data-initial={initial?.slug} data-index={url('music')}>
  <ul class="videos">
    {
      videos.map((v, i) => (
        <li class="video">
          {/* A thumbnail that opens the video in a large player overlay (see script below).
              Without JavaScript it's a plain link to the video on YouTube. */}
          <a
            class="video-frame"
            href={url(`music/${v.slug}`)}
            data-video={v.id}
            data-slug={v.slug}
            data-title={v.title}
            data-artist={v.artist}
            aria-label={`Play ${v.title} by ${v.artist}`}
          >
            <img
              src={`https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`}
              width="1280"
              height="720"
              alt=""
              loading={i < 4 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <span class="video-play" aria-hidden="true" />
          </a>
          <h2 class="video-title">{v.title}</h2>
          <p class="video-artist">{v.artist}</p>
        </li>
      ))
    }
  </ul>
</main>

<SiteFooter />

<dialog class="video-overlay" aria-label="Music video">
  <button type="button" class="video-overlay-close" aria-label="Close">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
  </button>
  <div class="video-overlay-body">
    <div class="video-overlay-player"></div>
    <p class="video-overlay-caption">
      <span class="video-overlay-title"></span>
      <span class="video-overlay-artist"></span>
    </p>
  </div>
</dialog>

<script>
  // Clicking a thumbnail opens the video in a large overlay. The YouTube player
  // is only created then (and removed on close, which stops playback), so the
  // page doesn't load thirteen players up front.
  const overlay = document.querySelector<HTMLDialogElement>('.video-overlay')!;
  const player = overlay.querySelector<HTMLElement>('.video-overlay-player')!;
  const titleEl = overlay.querySelector<HTMLElement>('.video-overlay-title')!;
  const artistEl = overlay.querySelector<HTMLElement>('.video-overlay-artist')!;

  const main = document.querySelector<HTMLElement>('main.music')!;
  const indexUrl = main.dataset.index!;

  function show(link: HTMLAnchorElement) {
    const { video, title = 'Music video', artist = '' } = link.dataset;
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${video}?autoplay=1&rel=0&playsinline=1`;
    iframe.title = `${title}${artist ? ` by ${artist}` : ''}`;
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    iframe.allowFullscreen = true;
    player.replaceChildren(iframe);
    titleEl.textContent = title;
    artistEl.textContent = artist;
    overlay.setAttribute('aria-label', iframe.title);
    if (!overlay.open) overlay.showModal();
  }

  function linkFor(slug: string | undefined) {
    return slug ? document.querySelector<HTMLAnchorElement>(`a[data-slug="${CSS.escape(slug)}"]`) : null;
  }

  function slugFromLocation() {
    return decodeURIComponent(location.pathname).replace(/\/+$/, '').split('/').pop();
  }

  // Each video has its own URL (/music/<slug>) so it can be shared.
  function open(link: HTMLAnchorElement) {
    history.pushState({ video: link.dataset.slug }, '', link.href);
    show(link);
  }

  document.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[data-video]');
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
    event.preventDefault();
    open(link);
  });

  function close() {
    // If we pushed the video's URL, going back closes the overlay (see popstate);
    // if the page was opened directly on it, just swap the URL back to /music.
    if (history.state?.video) history.back();
    else {
      overlay.close();
      history.replaceState(null, '', indexUrl);
    }
  }

  overlay.querySelector('.video-overlay-close')!.addEventListener('click', close);
  // Clicking the dark area around the player closes it too.
  overlay.addEventListener('click', (event) => {
    if (event.target === overlay || event.target === overlay.querySelector('.video-overlay-body')) close();
  });
  // Esc closes the dialog natively; keep the URL in step.
  overlay.addEventListener('cancel', (event) => {
    event.preventDefault();
    close();
  });
  // Removing the player stops the video.
  overlay.addEventListener('close', () => player.replaceChildren());

  window.addEventListener('popstate', () => {
    const link = linkFor(slugFromLocation());
    if (link) show(link);
    else overlay.close();
  });

  // Landing directly on /music/<slug>: open that video straight away.
  const initial = linkFor(main.dataset.initial);
  if (initial) {
    history.replaceState({ video: null }, '', location.href);
    show(initial);
  }
</script>
