---
interface Props {
  options: { value: string; label: string; count: number }[];
  total: number;
}

const { options, total } = Astro.props;
---

<nav class="filters" aria-label="Filter artworks by medium">
  <button type="button" class="filter" data-filter="all" aria-pressed="true">
    All <span class="filter-count">{total}</span>
  </button>
  {
    options.map((o) => (
      <button type="button" class="filter" data-filter={o.value} aria-pressed="false">
        {o.label} <span class="filter-count">{o.count}</span>
      </button>
    ))
  }
</nav>
